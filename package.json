{
  "name": "flight-recorder",
  "version": "0.1.0",
  "description": "A local black box for your PC — apps, downloads, builds, and spikes as a searchable timeline.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "flight-recorder": "./src/cli.ts"
  },
  "scripts": {
